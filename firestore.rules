rules_version = '2';

// Backs item 4 (cross-device stats + pairing) and the library-consolidation round (see
// TODO.md's Current Objective). Collections:
//
//   users/{uid}/stats/{size}  — per-grid-size completion stats (src/stats.js). Owning-uid
//     only, both read and write — no sharing/friend-visibility yet (that's item 9's
//     concern). "Owning uid" is meaningful even across pairing: redeeming a pairing code
//     re-authenticates the second device as the first device's uid (see
//     functions/index.js's redeemPairingCode) rather than trying to merge two separate
//     Firebase Auth identities, so a plain request.auth.uid == uid check is all that's
//     needed here — no merge-aware special-casing.
//
//   users/{uid}/solvedLibraryPuzzles/{puzzleId} — per-user "have I solved this puzzle"
//     tracking (src/puzzleLibrary.js's recordPuzzleSolved/fetchSolvedPuzzles), keyed by
//     the puzzle's own id — works uniformly for both a built-in SAMPLE_PUZZLES id (e.g.
//     'heart-5') and a Firestore-generated `puzzles/{puzzleId}` id, since this is just a
//     client-chosen document id under the player's own uid subcollection, not a reference
//     that has to resolve against the public `puzzles` collection. Same owning-uid-only
//     rule as `stats` above, and the same reasoning: pairing already re-authenticates onto
//     the same uid, so no separate cross-device logic is needed here either. This is a
//     personal record (times solved, personal best time) — never a public/competitive
//     value — so a plain client write is fine, unlike a hypothetical global fastest-time
//     stat (see TODO.md's note on why that one, if ever built, would need a Cloud Function
//     instead).
//
//   pairingCodes/{code} — short-lived code -> uid mappings. Only ever read/written by the
//     createPairingCode/redeemPairingCode Cloud Functions via the Admin SDK, which bypasses
//     these rules entirely — so client access is locked down completely rather than given
//     its own (harder to get right) rule.
//
//   users/{uid}/inProgressPuzzles/{puzzleId} — saved mid-solve board state (Current
//     Objective's saved/incomplete-progress item, src/puzzleLibrary.js's
//     saveInProgressPuzzle/loadInProgressPuzzle/fetchInProgressPuzzles/
//     deleteInProgressPuzzle), keyed the same uniform way as solvedLibraryPuzzles above.
//     Same owning-uid-only rule and reasoning — a personal save, never a public value.
//
//   users/{uid}/hiddenLibraryPuzzles/{puzzleId} — per-user "I've hidden this puzzle from
//     my own browse list" tracking (Current Objective's hide-a-puzzle item,
//     src/puzzleLibrary.js's hidePuzzleInLibrary/unhidePuzzleInLibrary/fetchHiddenPuzzles),
//     keyed the same uniform way as solvedLibraryPuzzles above. Same owning-uid-only rule —
//     a personal preference, never visible to or affecting any other player.
//
//   puzzles/{puzzleId} — the public shared puzzle library (item 9's save-to-library slice,
//     see src/puzzleLibrary.js and TODO.md). Public read for this first version (no
//     friends-only/private sharing yet). create is open to any authenticated (including
//     anonymous) user, but only as the doc's own creator, with light shape validation since
//     this is a public write-open collection. update is restricted to the original creator
//     AND scoped to only the `title` field — dimensions, clues, and creatorUid must never
//     change after creation. No delete yet (not needed for this round).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/stats/{size} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/solvedLibraryPuzzles/{puzzleId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/inProgressPuzzles/{puzzleId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/hiddenLibraryPuzzles/{puzzleId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /pairingCodes/{code} {
      allow read, write: if false;
    }

    match /puzzles/{puzzleId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.rows is int
        && request.resource.data.cols is int
        && request.resource.data.rowClues is list
        && request.resource.data.colClues is list;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.creatorUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0;
      allow delete: if false;
    }
  }
}
